# Production settings for docker compose. Copy to .env on the server and fill in.

# The site's main address, and the address that redirects to it. DNS A records
# for both must point at the server before starting, for HTTPS to work.
SITE_DOMAIN=www.byttrading.com
REDIRECT_DOMAIN=byttrading.com

# Generate each one with: openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

RESEND_API_KEY=
MAIL_FROM=BYT Trading <no-reply@byttrading.com>

COINGECKO_API_BASE=https://api.coingecko.com/api/v3

# How many daily backups to keep
SQLITE_BACKUP_KEEP=14

# Only while another web server on this machine holds ports 80 and 443. See
# "Sharing the server" in the README. Delete both lines when it is gone.
# COMPOSE_FILE=docker-compose.yml:docker-compose.behind-proxy.yml
# WEB_PORT=8088
