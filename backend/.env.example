# Pooled (Supavisor, session mode / port 5432) — used by the running app via the pg driver adapter.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Direct (non-pooled) connection — used by the Prisma CLI for migrate/db push/studio.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

COOKIE_DOMAIN="localhost"
FRONTEND_URL="http://localhost:3000"
PORT=4000

MAIL_PROVIDER="smtp"
MAIL_HOST=""
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="BYT Trading <no-reply@byttrading.com>"

COINGECKO_API_BASE="https://api.coingecko.com/api/v3"

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

NODE_ENV="development"
