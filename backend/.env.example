# Pooled (Supavisor, session mode / port 5432) — used for migrations (data-source.ts),
# which need session mode's advisory locks and prepared statements.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# Pooled (Supavisor, transaction mode / port 6543) — used by the running app itself.
# Transaction mode multiplexes far more concurrent clients than session mode's small
# pool_size cap, so app restarts/redeploys can't exhaust it. Optional: falls back to
# DATABASE_URL if unset, but production should set this to the port 6543 connection string.
DATABASE_POOL_URL="postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# Direct (non-pooled) connection — used by the Prisma CLI for migrate/db push/studio.
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

COOKIE_DOMAIN="localhost"
# Comma-separated list of allowed CORS origins (e.g. apex + www).
FRONTEND_URL="http://localhost:3000"
PORT=4000

MAIL_PROVIDER="smtp"
MAIL_HOST=""
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="BYT Trading <no-reply@byttrading.com>"

COINGECKO_API_BASE="https://api.coingecko.com/api/v3"

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

NODE_ENV="development"
